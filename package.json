{
  "name": "@supcio/ksef-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Polish KSeF 2.0 e-invoicing system",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src/ test/",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ksef",
    "e-invoicing",
    "poland",
    "faktura",
    "invoice",
    "tax"
  ],
  "author": "Supcio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/supcio/ksef-sdk.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "fast-xml-parser": "^4.5.0",
    "xml-crypto": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "msw": "^2.6.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  }
}
